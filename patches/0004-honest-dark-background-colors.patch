Honest dark-mode background colors + live filter updates.

The stored SKDarkBackgroundColor/SKDarkFullScreenBackgroundColor now mean
"the color you see": when the inverted-dark-mode filter would process the
window background, the render chokepoint feeds it a pre-compensated color
so the stored color renders literally (upstream #1774). Adds shared invert
math (SKPlusInvertMath), live re-push of backgrounds when invert state or
the Skim+ background level change, and live filter rebuild on the level.
Colors outside the filter's gamut render as their nearest achievable color.

--- /dev/null
+++ SKPlusInvertMath.h
@@ -0,0 +1,31 @@
+//
+//  SKPlusInvertMath.h
+//  Skim+
+//
+//  Shared math for the inverted-dark-mode filter: computing the current
+//  strength factor, and pre-compensating colors so a stored color renders
+//  literally under the filter. Mirrors colorInvertFilters in
+//  NSGraphics_SKExtensions.m — keep the two in sync.
+//  Part of the Skim+ patch set (https://github.com/speckofthecosmos/skim-plus).
+//  License: BSD, same as Skim.
+//
+
+#import <Cocoa/Cocoa.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+#define SKInvertedDarkModeBackgroundGrayKey @"SKInvertedDarkModeBackgroundGray"
+
+// The strength factor f the invert filter is currently using
+extern double SKPlusCurrentInvertF(void);
+
+// YES when content is being rendered through the invert filter
+extern BOOL SKPlusInvertRenderingActive(void);
+
+// Forward transform: what `color` looks like after the invert filter at strength f
+extern NSColor *SKPlusRenderedColor(NSColor *color, double f);
+
+// Inverse transform: the color to FEED the filter so it renders `desired`
+extern NSColor *SKPlusPreInvertedColor(NSColor *desired, double f);
+
+NS_ASSUME_NONNULL_END
--- /dev/null
+++ SKPlusInvertMath.m
@@ -0,0 +1,62 @@
+//
+//  SKPlusInvertMath.m
+//  Skim+
+//
+//  See SKPlusInvertMath.h. The filter chain (per channel, linear space) is:
+//  gamma 0.625 -> out_i = in_i - f*L + 1 (L = Rec.709 luminance) -> gamma 1.6.
+//  License: BSD, same as Skim.
+//
+
+#import "SKPlusInvertMath.h"
+#import "SKStringConstants.h"
+#import "NSGraphics_SKExtensions.h"
+
+#define LUM_R 0.2126
+#define LUM_G 0.7152
+#define LUM_B 0.0722
+
+static double toLinear(double c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }
+static double fromLinear(double c) { return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055; }
+static double clamp01(double c) { return fmin(fmax(c, 0.0), 1.0); }
+
+double SKPlusCurrentInvertF(void) {
+    NSNumber *bgGray = [[NSUserDefaults standardUserDefaults] objectForKey:SKInvertedDarkModeBackgroundGrayKey];
+    if (bgGray) {
+        double gray = clamp01([bgGray doubleValue]);
+        return 2.0 - pow(toLinear(gray), 0.625);
+    }
+    return [[NSWorkspace sharedWorkspace] accessibilityDisplayShouldIncreaseContrast] ? 1.9338 : 1.8972;
+}
+
+BOOL SKPlusInvertRenderingActive(void) {
+    return SKHasDarkAppearance() && [[NSUserDefaults standardUserDefaults] boolForKey:SKInvertColorsInDarkModeKey];
+}
+
+NSColor *SKPlusRenderedColor(NSColor *color, double f) {
+    NSColor *c = [color colorUsingColorSpace:[NSColorSpace sRGBColorSpace]];
+    double r = pow(toLinear([c redComponent]), 0.625);
+    double g = pow(toLinear([c greenComponent]), 0.625);
+    double b = pow(toLinear([c blueComponent]), 0.625);
+    double L = LUM_R * r + LUM_G * g + LUM_B * b;
+    double outR = pow(clamp01(r - f * L + 1.0), 1.6);
+    double outG = pow(clamp01(g - f * L + 1.0), 1.6);
+    double outB = pow(clamp01(b - f * L + 1.0), 1.6);
+    return [NSColor colorWithSRGBRed:fromLinear(outR) green:fromLinear(outG) blue:fromLinear(outB) alpha:1.0];
+}
+
+NSColor *SKPlusPreInvertedColor(NSColor *desired, double f) {
+    if (f <= 1.0001)
+        return desired; // degenerate filter; identity is the least-wrong answer
+    NSColor *d = [desired colorUsingColorSpace:[NSColorSpace sRGBColorSpace]];
+    // From out = (c - f*L + 1)^1.6: t = out^(1/1.6); luminance of both sides
+    // gives L = (1 - Lt) / (f - 1); then c = t + f*L - 1.
+    double tR = pow(toLinear([d redComponent]), 1.0 / 1.6);
+    double tG = pow(toLinear([d greenComponent]), 1.0 / 1.6);
+    double tB = pow(toLinear([d blueComponent]), 1.0 / 1.6);
+    double Lt = LUM_R * tR + LUM_G * tG + LUM_B * tB;
+    double L = (1.0 - Lt) / (f - 1.0);
+    double r = pow(clamp01(tR + f * L - 1.0), 1.0 / 0.625);
+    double g = pow(clamp01(tG + f * L - 1.0), 1.0 / 0.625);
+    double b = pow(clamp01(tB + f * L - 1.0), 1.0 / 0.625);
+    return [NSColor colorWithSRGBRed:fromLinear(r) green:fromLinear(g) blue:fromLinear(b) alpha:1.0];
+}
